                    <li onclick="addToBag(8), disable('bulletPoint8')" id="bulletPoint8"><div class="bulletPoint" id="bulletPoint8"></div><p>Forventninger</p></li>
                    <li onclick="addToBag(7), disable('bulletPoint7')" id="bulletPoint7"><div class="bulletPoint" id="bulletPoint7" onclick="addToBag(8)"></div><p>Karakterer</p></li>
                    <li onclick="addToBag(10), disable('bulletPoint10')" id="bulletPoint10"><div class="bulletPoint" id="bulletPoint10" onclick="addToBag(7)"></div><p>Skolepress</p></li>
                    <li onclick="addToBag(4), disable('bulletPoint4')" id="bulletPoint4"><div class="bulletPoint" id="bulletPoint4" onclick="addToBag(4)"></div><p>Økonomi</p></li>
                    <li onclick="addToBag(6),disable('bulletPoint6')" id="bulletPoint6"><div class="bulletPoint" id="bulletPoint6" onclick="addToBag(6)"></div><p>Familie</p></li>
                    <li onclick="addToBag(5), disable('bulletPoint5')" id="bulletPoint5"><div class="bulletPoint" id="bulletPoint5" onclick="addToBag(5)"></div><p>Venner</p></li>
                    <li onclick="addToBag(9), disable('bulletPoint9')" id="bulletPoint9"><div class="bulletPoint" id="bulletPoint9" onclick="addToBag(9)"></div><p>Sosiale Medier</p></li>
                    <li onclick="addToBag(3), disable('bulletPoint3')" id="bulletPoint3"><div class="bulletPoint" id="bulletPoint3" onclick="addToBag(3)"></div><p>Framtiden</p></li>
                    <li onclick="addToBag(2), disable('bulletPoint2')" id="bulletPoint2"><div class="bulletPoint" id="bulletPoint2" onclick="addToBag(2)"></div><p>Søvn og hvile</p></li>
                    <li onclick="addToBag(1), disable('bulletPoint1')" id="bulletPoint1"><div class="bulletPoint" id="bulletPoint1" onclick="addToBag(1)"></div><p>Kropp og utseende</p></li>
                </ol>
            </div>
            <div class="formDiv">
            <form action="" id="sekkForm">
                <label for="">Halla på dæ</label>
                    <select id="selectForm">
                        <option value="10">Skolepress</option>
                        <option value="8">Forventninger</option>
                        <option value="7">Karakterer</option>
                        <option value="4">Økonomi</option>
                        <option value="6">Familie</option>
                        <option value="5">Venner</option>
                        <option value="9">Sosiale Medier</option>
                        <option value="3">Framtiden</option>
                        <option value="2">Søvn og hvile</option>
                        <option value="1">Kropp og utseende</option>
                    </select>
            </form>
            </div>
        </div>
        <div id="right">
            <div id="righttop">
                <div id="rightleft">
                <div id="backpackcontainer">
                    <img src="/img/open-backpack-back.png" id="backpack" class="backpackBack" draggable="false">
                    <img src="/img/open-backpack-front.png" id="backpack2" class="backpackFront" draggable="false">
                </div>
                <h2 id="scoreText">0</h2>
                </div>
                <div id="rightright">
                </div>
            </div>


            <div id="rightbottom">
                <div class="sekkMedTingDiv" id="sekkDiv">
            <!-- <button class="resetButton" id="resetButton">Reset</button> -->
            </div>
            </div>
        </div>
